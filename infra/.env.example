# --- Hub ---
DATABASE_URL=postgresql+psycopg://smashfire:smashfire@postgres:5432/smashfire_hub
REDIS_URL=redis://redis:6379/0
HUB_JWT_SECRET=change-me

# AI providers — Hub-only. Never present in the plugin's environment.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Wired in during later phases (Phase 5/6) — leave blank until then.
STRIPE_SECRET_KEY=
CLOUDFLARE_TURNSTILE_SECRET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
RESEND_API_KEY=

