{
    "name": "smashfire/smashfire-pr",
    "description": "WordPress plugin client for the Smashfire PR Hub",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10",
        "squizlabs/php_codesniffer": "^3",
        "wp-coding-standards/wpcs": "^3"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
